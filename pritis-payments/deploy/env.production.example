# /etc/pritis-dues/env — secrets for the dpp-* services. Owner dpp, mode 600:
#   sudo install -o dpp -g dpp -m 600 env.production.example /etc/pritis-dues/env
# Values containing spaces MUST be in double quotes (the release script also reads this file).

ENVIRONMENT=production
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://pritis_dues:CHANGE_ME@localhost:5432/pritis_dues

APP_BASE_URL=https://dpp.pritis.name.ng
ADMIN_BASE_URL=https://admin.dpp.pritis.name.ng

# New values for production; never reuse the local ones.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep a copy in your password manager: without it, staff authenticators and rep bank
# account numbers in the database (and in every backup) can't be read.
DATA_ENCRYPTION_KEY=

# sk_test_... on staging; sk_live_... only when going live.
PAYSTACK_SECRET_KEY=

STORAGE_BACKEND=r2
STORAGE_LOCAL_DIR=/srv/pritis-dues/var/uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pritis-dues-files
R2_BACKUP_BUCKET=pritis-dues-backups

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

EMAIL_BACKEND=brevo
EMAIL_FROM="Pritis DPP <no-reply@pritis.name.ng>"
BREVO_API_KEY=
