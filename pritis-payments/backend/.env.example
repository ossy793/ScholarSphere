# Copy to backend/.env and fill in. Never commit the real .env.

# local | test | staging | production  (/api/docs is disabled in production)
ENVIRONMENT=local

# Main database (async driver required)
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/pritis_dues

# Separate database used only by pytest; it is wiped on every test run
TEST_DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/pritis_dues_test

LOG_LEVEL=INFO

# Public address of the user site (emailed links, Google redirect)
APP_BASE_URL=http://localhost:8100

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Public address of the admin site (staff invitation links).
# Locally, browsers resolve admin.localhost to this machine.
ADMIN_BASE_URL=http://admin.localhost:8100

# Encrypts staff authenticator secrets and rep bank account numbers. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never change it once data exists, or that data can no longer be read.
DATA_ENCRYPTION_KEY=

# Paystack (Settings > API Keys & Webhooks). Test key until launch.
PAYSTACK_SECRET_KEY=sk_test_xxx

# Uploaded files (rep proof of studentship). "local" stores them in backend/var/uploads;
# "r2" uses Cloudflare R2 (R2 > Manage API tokens: Object Read & Write on one bucket).
STORAGE_BACKEND=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Google sign-in (Google Cloud Console > APIs & Services > Credentials > OAuth client ID).
# Authorised redirect URI: {APP_BASE_URL}/api/user/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# "console" prints emails to the outbox worker's log (development).
# "brevo" sends them through Brevo; needs BREVO_API_KEY and a sender address that is
# verified in Brevo (Senders, Domains & Dedicated IPs).
EMAIL_BACKEND=console
EMAIL_FROM=Pritis DPP <no-reply@pritis.name.ng>
# Brevo > SMTP & API > API keys > Generate a new API key
BREVO_API_KEY=
